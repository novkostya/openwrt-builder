# asf: the router at the other site, an x86-64 VM on Proxmox; no VRRP partner there.
TARGET=x86/64
PROFILE=generic
# package architecture, also in the names of the awg-openwrt and upstream sing-box release assets
ARCH_PACKAGES=x86_64
# rootfs partition size in MB
ROOTFS_PARTSIZE=256
LISTS="x86-vm x86-router"
OVERLAYS="base etcgit tailscale x86-vm"
