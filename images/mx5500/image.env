# mx5500: Linksys MX5500 access point and VRRP backup router for dxb.
TARGET=qualcommax/ipq50xx
PROFILE=linksys_mx5500
# package architecture, also in the names of the awg-openwrt release assets
ARCH_PACKAGES=aarch64_cortex-a53
EXTRA_IMAGE_NAME=mx5500-ap
# sing-box built from source with only what the AP needs: Hysteria2/Realms (QUIC).
# Tailscale comes from the OpenWrt package instead.
SINGBOX_BUILD_TAGS=with_quic,badlinkname,tfogo_checklinkname0
SINGBOX_GOARCH=arm64
LISTS=""
OVERLAYS="base etcgit tailscale"
