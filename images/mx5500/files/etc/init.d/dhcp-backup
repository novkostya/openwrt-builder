#!/bin/sh /etc/rc.common
# Backup DHCP for the LAN and guest Wi-Fi: a DHCP-only dnsmasq (port=0) next to the main one.
# Never started at boot: keepalived's notify script starts it while this AP is the VRRP master.
# Its config, /etc/dhcp-backup/dnsmasq.conf, copies the primary router's DHCP settings (kept in this device's /etc repo).
# No START/STOP on purpose, so neither ImageBuilder nor `enable` can add rc.d links for it.

USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/dnsmasq -k -C /etc/dhcp-backup/dnsmasq.conf
	procd_set_param respawn 3600 5 0
	procd_close_instance
}
