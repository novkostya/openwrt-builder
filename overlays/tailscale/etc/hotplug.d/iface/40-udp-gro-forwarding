# Faster UDP forwarding through the WAN port for Tailscale's WireGuard traffic
# (https://tailscale.com/s/ethtool-config-udp-gro): enable UDP GRO forwarding, disable GRO list.
[ "$ACTION" = ifup ] || exit 0
[ "$INTERFACE" = wan ] || exit 0
command -v ethtool >/dev/null || exit 0
ethtool -K "$DEVICE" rx-udp-gro-forwarding on rx-gro-list off 2>/dev/null
logger -t udp-gro "rx-udp-gro-forwarding on, rx-gro-list off for $DEVICE"
