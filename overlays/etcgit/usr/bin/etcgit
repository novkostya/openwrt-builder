#!/bin/sh
# etcgit — Git wrapper for /etc
# Repo: /root/.etcgit, work tree: /etc. "*" in info/exclude, so only files added with "add -f" are
# tracked; "etcgit status" also lists the files that differ from the image but aren't tracked.

set -e

REPO="/root/.etcgit"
UPPER="/overlay/upper/etc"
LEGACY="$UPPER/.git"   # the repo used to be the overlay's upper /etc; "etcgit migrate" moves it

need_git() { command -v git >/dev/null 2>&1 || { echo "git not found"; exit 1; }; }
g() { git --git-dir="$REPO" --work-tree=/etc "$@"; }
# After writing to the old repo place behind overlayfs, so the merged /etc doesn't serve stale files
drop_caches() { sync; { echo 3 > /proc/sys/vm/drop_caches; } 2>/dev/null || true; }

# Files in the overlay's upper /etc (changed from the image or new) that aren't tracked, minus .gitignore
changed_untracked() {
  [ -d "$UPPER" ] || return 0
  ( cd "$UPPER" && git --git-dir="$REPO" --work-tree=. ls-files --others --exclude-per-directory=.gitignore )
}

setup_repo() {
  g config user.name  >/dev/null || g config user.name "etcgit"
  g config user.email >/dev/null || g config user.email "root@openwrt"
  g config core.bare false
  g config core.worktree /etc
  mkdir -p "$REPO/info"
  grep -qx '\*' "$REPO/info/exclude" 2>/dev/null || echo '*' >> "$REPO/info/exclude"
}

check_free() {
  [ ! -e "$REPO" ] || { echo "$REPO already exists"; exit 1; }
  [ ! -d "$LEGACY" ] || { echo "$LEGACY exists: run etcgit migrate"; exit 1; }
}

cmd_init() {
  # etcgit init [remote-url]
  need_git
  if [ ! -d "$REPO" ]; then
    check_free
    g init -q
    setup_repo
    [ -f /etc/.gitignore ] || cat <<EOF >/etc/.gitignore
board.json
urandom.seed
passwd-
shadow-
gshadow-
*.opkg-*
opkg-lists/
.uci-*
*~
*.swp
*.
EOF
    g add -f .gitignore
    changed_untracked | while read -r f; do g add -f -- "$f"; done
    g commit -q -m "etcgit: initial snapshot" || true
  fi
  if [ -n "$1" ]; then
    if g remote | grep -qx origin; then
      g remote set-url origin "$1"
    else
      g remote add origin "$1"
    fi
  fi
  echo "Initialized $REPO for /etc"
}

cmd_import() {
  # etcgit import <remote-url>
  need_git
  REMOTE="$1"
  [ -n "$REMOTE" ] || { echo "usage: etcgit import <remote-url>"; exit 1; }
  check_free

  TMP="$(mktemp -d /tmp/etcgit.XXXXXX)"
  # shallow clone so origin/HEAD is set by git itself; /etc stays untouched until you check out
  git clone -q --depth=1 --no-checkout --separate-git-dir="$REPO" "$REMOTE" "$TMP"
  rm -rf "$TMP"
  setup_repo
  g reset -q
  echo "Imported $REMOTE into $REPO"

  if [ -n "$(g status --porcelain 2>/dev/null || true)" ]; then
    echo
    echo "⚠ /etc differs from the repo"
    g status -sb 2>/dev/null | sed 's/^/   /'
    echo "→ Review with etcgit diff, then etcgit checkout -- <files> (or etcgit reset --hard)"
  fi
  echo "⚠️  Reboot is strongly recommended after checking out, so all services reload their configs."
}

cmd_migrate() {
  # Move a repo from the overlay's upper /etc to $REPO
  need_git
  [ -d "$LEGACY" ] || { echo "nothing to migrate: no $LEGACY"; exit 1; }
  [ ! -e "$REPO" ] || { echo "$REPO already exists"; exit 1; }
  drop_caches
  mv /etc/.git "$REPO"
  setup_repo
  echo "Moved /etc/.git to $REPO"
  echo "→ Check etcgit status, and drop /etc/.git, /etc/.gitignore and /root/.ssh/ from"
  echo "  /etc/sysupgrade.conf: /lib/upgrade/keep.d/etcgit keeps them now"
}

cmd_status() {
  g status "$@"
  for a in "$@"; do
    case "$a" in --porcelain*|-z|--null) return 0 ;; esac
  done
  list="$(changed_untracked)"
  [ -n "$list" ] || return 0
  echo
  echo "Changed from the image, not tracked (etcgit add -f <file>, or list it in /etc/.gitignore):"
  echo "$list" | sed 's/^/	/'
}

usage() {
  cat <<EOF
etcgit — Git wrapper for /etc configs

Commands:
  init [remote-url]   Initialize repo (optional: set origin)
  import <remote-url> Fetch a repo for /etc from remote (via tmp clone)
  migrate             Move a repo from /overlay/upper/etc/.git to $REPO
  changed             List files that differ from the image but aren't tracked

All other args are proxied to: git --git-dir=$REPO --work-tree=/etc <args>
New files are ignored until added with -f. Examples:
  etcgit status
  etcgit add -f config/foo && etcgit commit -m "tweak configs"
  etcgit push origin main
EOF
}

case "$1" in
  init) shift; cmd_init "$@";;
  import) shift; cmd_import "$@";;
  migrate) shift; cmd_migrate "$@";;
  changed) need_git; changed_untracked;;
  ""|help|-h|--help) usage;;
  *)
    need_git
    if [ ! -d "$REPO" ] && [ -d "$LEGACY" ]; then
      echo "etcgit: the repo is still in $LEGACY; run etcgit migrate" >&2
      rc=0; git -C "$UPPER" "$@" || rc=$?
      drop_caches
      exit $rc
    fi
    if [ "$1" = status ]; then shift; cmd_status "$@"; else g "$@"; fi
    ;;
esac
